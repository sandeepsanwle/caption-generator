PORT=5000
# If omitted, the app will use an in-memory job store (still fully works).
MONGO_URI=mongodb://127.0.0.1:27017/caption_generator

# If you want larger uploads, adjust:
MAX_UPLOAD_MB=500

# Optional: full path to Python for "python -m whisper" (e.g. venv).
# If unset, the server uses the "whisper" CLI on PATH.
# WHISPER_PYTHON=/path/to/whisper-env/bin/python
