PORT=5000
# If omitted, the app will use an in-memory job store (still fully works).
MONGO_URI=mongodb://127.0.0.1:27017/caption_generator

# If you want larger uploads, adjust:
MAX_UPLOAD_MB=500

# Python transcription service URL (must be running for auto captions).
# Start it with: cd python-service && pip install -r requirements.txt && uvicorn main:app --reload
TRANSCRIPTION_SERVICE_URL=http://127.0.0.1:8000
